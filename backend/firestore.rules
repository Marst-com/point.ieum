rules_version = '2';
// 모든 DB 접근은 백엔드(Admin SDK)만 한다. 클라이언트(브라우저/앱) 직접 접근은 전부 막는다.
// 다른 시스템의 "서버"가 읽는 건 Admin SDK + 읽기 전용 서비스 계정으로 한다 (규칙은 Admin SDK 에 적용되지 않는다). README 의 'DB 공유' 참고.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
