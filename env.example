# =====================================================================
# IEUM PointSystem 환경변수 예시
#  - 서버(호스팅)의 환경변수 설정 화면에 이 값들을 그대로 넣으면 돼. (.env 파일은 배포되지 않으니까)
#  - 로컬에서 쓸 땐 이 파일을 backend/.env 로 복사해서 값을 채워 (루트의 .gitignore 가 .env 는 올리지 않게 막아 줘)
# =====================================================================

# --- 필수 (운영) ---
NODE_ENV=production
JWT_SECRET=긴-랜덤-문자열로-바꿔줘
# Firebase Admin 인증: 서비스 계정 JSON 파일의 "내용 전체"를 한 줄로 넣어.
# (JSON 파일은 gitignore 라 배포되지 않으니까, 파일 경로 말고 내용으로 넣는 게 배포할 땐 편해)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- 프론트를 따로 배포할 때 (같은 서버에서 같이 서빙하면 둘 다 비워 둬) ---
# 프론트가 올라간 주소 (쉼표로 여러 개). 여기 적은 주소에서만 이 서버를 부를 수 있어.
# 서브도메인 전체를 허용하는 https://*.example.com 도 되지만, 남이 만든 서브도메인까지 포함되니 정확한 주소를 권장해.
# CORS_ORIGIN=https://ieum.example.com
# 0 이면 이 서버는 API/실시간만 담당하고 프론트 파일은 내려주지 않아
# SERVE_FRONTEND=0

# --- 다른 시스템과 같은 Firebase 프로젝트를 쓸 때 ---
# 우리 컬렉션 이름 앞에 붙는 말 (기본 ieumps_ → ieumps_users, ieumps_rooms …). 다른 시스템의 users 같은 이름과 안 겹치게 해 줘.
# ⚠ 처음 데이터를 넣은 뒤에는 바꾸지 마. 바꾸면 기존 데이터가 옛 이름 컬렉션에 남아서 안 보이게 돼.
# DB_PREFIX=ieumps_
# 1 이면 서버를 켤 때마다 공유용 복사본(계정·입장권)을 원본 기준으로 맞춰 (사용자가 아주 많으면 켜는 데 오래 걸려)
# SYNC_ON_START=0

# --- 선택 ---
PORT=3000
# 돌 N개당 포인트 1 자동 지급 (0이면 끔 — 기본: 포인트는 관리자가 배부)
STONES_PER_POINT=0
# 로컬 개발용: 1이면 Firebase 없이 메모리 DB 사용 (재시작하면 데이터 사라짐 — NODE_ENV=production 에서는 쓸 수 없어)
USE_MEMORY_DB=0

# --- 검색 엔진 (비워 두면 이 서버 안에서 돌아감) ---
# 샤드 노드를 따로 띄웠다면 주소를 쉼표로. 이 값을 쓰면 SEARCH_KEY 가 꼭 필요해.
# SEARCH_NODES=http://10.0.0.11:7001,http://10.0.0.12:7001
# SEARCH_KEY=샤드-노드와-같은-비밀키
# 노드 없이 이 서버 안에서 쓸 때: 샤드 개수 / 디스크 저장 폴더(없으면 메모리 전용)
# SEARCH_LOCAL_SHARDS=1
# SEARCH_DATA_DIR=./data/search
